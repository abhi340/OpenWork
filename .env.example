# OpenWork Production & Development Environment Variables
# Copy this file to .env.local for local overrides or configure in Cloudflare Pages dashboard.

# -----------------------------------------------------------------------------
# 1. PocketBase Backend Database Endpoint
# -----------------------------------------------------------------------------
# Production: Set to your hosted PocketBase URL (e.g. https://openwork-db.pockethost.io)
# Local Dev: Defaults to http://127.0.0.1:8090
NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090

# -----------------------------------------------------------------------------
# 2. Server-side AI Provider API Keys (Optional Global Fallbacks)
# -----------------------------------------------------------------------------
# If users do not set their own BYO keys in Settings, OpenWork will fall back
# to these server-level environment variables to power the AI Copilot out-of-the-box.

# NVIDIA NIM (NVIDIA Integrated Microservices - 100% Free Cloud APIs)
NVIDIA_API_KEY=

# Groq (Llama-3.3-70b High-Speed Cloud API)
GROQ_API_KEY=

# OpenAI (GPT-4o / GPT-4o-mini)
OPENAI_API_KEY=

# OpenRouter (Multi-model Cloud Gateway)
OPENROUTER_API_KEY=

# Google Gemini (Gemini 1.5/2.0 Flash)
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# 3. Application Metadata & Security
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
